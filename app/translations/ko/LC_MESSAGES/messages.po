msgid "Some numbers were not understood and were left out."
msgstr "일부 숫자를 이해하지 못해 제외했습니다."

#: app/services/telegram_bot.py:153
msgid "/undo to remove it."
msgstr "삭제하려면 /undo."

#: app/services/telegram_bot.py:159
msgid "Your account cannot add fuel logs."
msgstr "이 계정은 주유 기록을 추가할 수 없습니다."

#: app/services/telegram_bot.py:162
#, python-format
msgid "Which vehicle? Send the message again with one of: %(names)s"
msgstr "어느 차량입니까? 다음 중 하나를 넣어 다시 보내십시오: %(names)s"

