msgstr "Fő"

#: app/templates/vehicles/view.html:640
msgid "Set as main"
msgstr "Beállítás főképként"

#: app/templates/vehicles/view.html:647
msgid "Delete this photo?"
msgstr "Törlöd ezt a fényképet?"

#: app/templates/vehicles/view.html:657
msgid "No photos yet."
msgstr "Még nincsenek fényképek."

#: app/templates/vehicles/view.html:668
msgid "Archive this vehicle"
msgstr "Jármű archiválása"

#: app/templates/vehicles/view.html:669
msgid ""
"Archived vehicles won't appear in regular lists or calculations. You can "
"restore them later."
msgstr ""
"Az archivált járművek nem jelennek meg a szokásos listákban és "
"számításokban. Később visszaállíthatod őket."

#: app/templates/vehicles/view.html:671
msgid "Restore this vehicle"
msgstr "Jármű visszaállítása"

#: app/templates/vehicles/view.html:672
msgid ""
"Restore this vehicle to make it active again and include it in calculations."
msgstr ""
"Állítsd vissza ezt a járművet, hogy ismét aktív legyen, és bekerüljön a "
"számításokba."

#: app/templates/vehicles/view.html:678
msgid "Archive Vehicle"
msgstr "Jármű archiválása"

#: app/templates/vehicles/view.html:683
msgid "Restore Vehicle"
msgstr "Jármű visszaállítása"

#: app/templates/vehicles/view.html:689
msgid "Delete this vehicle"
msgstr "Jármű törlése"

#: app/templates/vehicles/view.html:690
msgid ""
"Once you delete a vehicle, there is no going back. This will also delete all"
" associated fuel logs and expenses."
msgstr ""
"A jármű törlése végleges, és nem vonható vissza. Ezzel együtt a hozzá "
"kapcsolódó összes tankolási napló és kiadás is törlődik."

#: app/templates/vehicles/view.html:693
msgid ""
"Are you sure you want to delete this vehicle? This action cannot be undone."
msgstr "Biztos, hogy törölni akarod ezt a járművet? Nincs visszaút!"

#: app/templates/vehicles/view.html:695
msgid "Delete Vehicle"
msgstr "Jármű törlése"

#: app/templates/vehicles/view.html:910
msgid ""
"Not enough data to show consumption trend. Add more fuel logs with full tank"
" fills."
msgstr ""
"Nincs elegendő adat a fogyasztási trend megjelenítéséhez. Rögzíts további, "
"teljes tankolásokat."

#: app/templates/vehicles/view.html:948
msgid "No fuel prices recorded yet."
msgstr "Még nem rögzítettek üzemanyag árat."
